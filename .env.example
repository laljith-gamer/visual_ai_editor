# =====================================================================
# Shorts Studio v1.0.0 — environment variables
# =====================================================================
# Every variable here is OPTIONAL. The app degrades gracefully:
#   - No GEMINI_API_KEY  → chat falls back to GROQ
#   - No GROQ_API_KEY    → chat fails with a friendly error
#   - No SESSION_SECRET  → ephemeral random secret per cold-start
#   - No UPSTASH_*       → rate limiting disabled (fine for local dev)
# =====================================================================

# --- Chat + Vision (recommended primary) ---
# https://aistudio.google.com/apikey   (free tier, no card required)
GEMINI_API_KEY=
# Override only if a newer model is available in your region.
GEMINI_MODEL=gemini-2.5-flash

# --- Chat fallback ---
# https://console.groq.com   (free tier, no card required)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Session signing (required in production) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Rate limit (optional, recommended in production) ---
# https://console.upstash.com   (free tier: 10k commands/day)
# When set, ALL four rate-limit layers (IP / session / global LLM budget /
# circuit breaker) become Upstash-backed and shared across Vercel function
# instances. When unset, the IP layer falls back to per-region in-memory
# buckets and the other layers no-op (best-effort).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin stats endpoint (optional) ---
# When set, GET /api/admin/stats becomes available with this token in the
# X-Admin-Token header. When unset, the endpoint returns 404 (hidden).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# --- Client-side feature flags ---
# Force a specific vision tier on the client. Leave empty to auto-detect.
#   "auto"          → WebGPU SigLIP if available, else cloud
#   "siglip-local"  → always run SigLIP in-browser
#   "cloud"         → always use cloud Gemini fallback
NEXT_PUBLIC_VISION_TIER=auto

# Force chat provider client-side. Leave empty for server-side default.
NEXT_PUBLIC_CHAT_PROVIDER=gemini

# Local-first editor (Phase 4, EXPERIMENTAL). Default OFF.
# When "true", a model-driven router runs in-browser (WebGPU, @mlc-ai/web-llm)
# BEFORE the cloud planner. In v1 it only answers `chat`/question turns
# locally (with grounding); every action and any low-confidence/unsupported
# case falls through to the unchanged Gemini/Groq flow. Requires WebGPU and
# downloads a model on first use. Leave empty/false for the standard cloud flow.
NEXT_PUBLIC_LOCAL_FIRST_EDITOR=false

# Build version surfaced in the UI footer.
NEXT_PUBLIC_APP_VERSION=1.7.1
