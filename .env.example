# =====================================================================
# Shorts Studio v1.0.0 — environment variables
# =====================================================================
# Every variable here is OPTIONAL. By DEFAULT (CLOUD_PROVIDER_ORDER unset)
# the app degrades gracefully:
#   - No OPENROUTER_API_KEY → falls back to GEMINI, then GROQ
#   - No GEMINI_API_KEY     → vision routes need OpenRouter (multimodal model)
#   - No GROQ_API_KEY        → text-only fallback unavailable
#   - No SESSION_SECRET     → ephemeral random secret per cold-start
#   - No UPSTASH_*          → rate limiting disabled (fine for local dev)
#
# THIS FILE is pinned to "OpenRouter only, one model (openai/gpt-5.5-pro)"
# as an example. With CLOUD_PROVIDER_ORDER=openrouter there is NO Gemini/Groq
# fallback — see the note on that variable below. To restore multi-provider
# behaviour, blank out CLOUD_PROVIDER_ORDER and use the mixed model slugs
# shown in the comments.
# =====================================================================

# --- Primary cloud model provider: OpenRouter (SERVER-SIDE ONLY) ---
# https://openrouter.ai/keys
# IMPORTANT: this key is read server-side only (lib/env.ts) and is NEVER
# exposed to the browser. Do NOT create a NEXT_PUBLIC_OPENROUTER_API_KEY.
# Put the real key in .env.local / your deployment environment (never commit it).
OPENROUTER_API_KEY=
# Model slugs (override the defaults in lib/config.ts OPENROUTER).
# Pinned here to ONE model for every tier. NOTE: today the dispatcher only
# uses OPENROUTER_DEFAULT_MODEL; CHEAP/PREMIUM/OSS are forward-compat and set
# to the same model so nothing can silently pick a different one later.
# To use a mix instead, e.g.:
#   OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash
#   OPENROUTER_CHEAP_MODEL=google/gemini-2.5-flash-lite
#   OPENROUTER_PREMIUM_MODEL=anthropic/claude-sonnet-4.5
#   OPENROUTER_OSS_MODEL=qwen/qwen3-coder
OPENROUTER_DEFAULT_MODEL=openai/gpt-5.5-pro
OPENROUTER_CHEAP_MODEL=openai/gpt-5.5-pro
OPENROUTER_PREMIUM_MODEL=openai/gpt-5.5-pro
OPENROUTER_OSS_MODEL=openai/gpt-5.5-pro
# Optional: sent to OpenRouter as the HTTP-Referer header (your app URL).
# APP_URL is server-only; NEXT_PUBLIC_APP_URL is also accepted if present.
APP_URL=

# --- Chat + Vision fallback (Gemini direct) ---
# https://aistudio.google.com/apikey   (free tier, no card required)
# NOTE: with CLOUD_PROVIDER_ORDER=openrouter (below) Gemini is NOT used at all,
# even if set. Only relevant when CLOUD_PROVIDER_ORDER includes "gemini".
GEMINI_API_KEY=
# Override only if a newer model is available in your region.
GEMINI_MODEL=gemini-2.5-flash

# --- Chat fallback (text only) ---
# https://console.groq.com   (free tier, no card required)
# NOTE: also unused while CLOUD_PROVIDER_ORDER=openrouter.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Cloud provider order / toggle (SERVER-ONLY) ---
# Controls which provider(s) the dispatcher uses and in what order.
# Comma-separated; names: openrouter | gemini | groq.
#   CLOUD_PROVIDER_ORDER=openrouter             # OpenRouter ONLY (no fallback)
#   CLOUD_PROVIDER_ORDER=gemini                 # Gemini only
#   CLOUD_PROVIDER_ORDER=openrouter,gemini,groq # OpenRouter, then fall back
# Unknown/duplicate names are ignored; a provider is only used if its API key
# above is set. Groq is text-only and is always skipped for vision routes.
#
# Use this only if you want OpenRouter pinned to one model with no fallback.
# With CLOUD_PROVIDER_ORDER=openrouter, if OpenRouter fails the request errors
# instead of calling Gemini/Groq. Leave EMPTY for the default fallback chain
# (openrouter,gemini,groq).
CLOUD_PROVIDER_ORDER=openrouter

# --- Session signing (required in production) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Rate limit (optional, recommended in production) ---
# https://console.upstash.com   (free tier: 10k commands/day)
# When set, ALL four rate-limit layers (IP / session / global LLM budget /
# circuit breaker) become Upstash-backed and shared across Vercel function
# instances. When unset, the IP layer falls back to per-region in-memory
# buckets and the other layers no-op (best-effort).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin stats endpoint (optional) ---
# When set, GET /api/admin/stats becomes available with this token in the
# X-Admin-Token header. When unset, the endpoint returns 404 (hidden).
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# --- Client-side feature flags ---
# Force a specific vision tier on the client. Leave empty to auto-detect.
#   "auto"          → WebGPU SigLIP if available, else cloud
#   "siglip-local"  → always run SigLIP in-browser
#   "cloud"         → always use cloud vision fallback
NEXT_PUBLIC_VISION_TIER=auto

# Force chat provider client-side. Leave empty for server-side default.
NEXT_PUBLIC_CHAT_PROVIDER=gemini

# NOTE: the experimental in-browser WebLLM local-first path
# (NEXT_PUBLIC_LOCAL_FIRST_EDITOR) was REMOVED in v1.8.x. Language/tool
# routing now runs server-side via OpenRouter (above). There is no
# in-browser model download and no local-model flag any more.

# Build version surfaced in the UI footer.
NEXT_PUBLIC_APP_VERSION=1.7.1
