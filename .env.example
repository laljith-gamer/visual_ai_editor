# =====================================================================
# Shorts Studio — environment variables
# =====================================================================
# CURRENT DEFAULT: local-only AI.
# Cloud model providers are disabled unless DISABLE_CLOUD_AI=false.
# The browser local WebLLM planner is enabled by default. It is text-only,
# runs on-device through WebGPU, and has no API key.
# =====================================================================

# --- Local-only switch (SERVER-SIDE) ---
# Default behavior when unset: cloud model providers are disabled.
# Set DISABLE_CLOUD_AI=false only when you intentionally want OpenRouter,
# Gemini, Groq, or a custom cloud provider to answer.
DISABLE_CLOUD_AI=true

# --- Primary cloud model provider: OpenRouter (SERVER-SIDE ONLY) ---
# These are ignored while DISABLE_CLOUD_AI=true.
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-5.5-pro
OPENROUTER_CHEAP_MODEL=openai/gpt-5.5-pro
OPENROUTER_PREMIUM_MODEL=openai/gpt-5.5-pro
OPENROUTER_OSS_MODEL=openai/gpt-5.5-pro
OPENROUTER_MAX_TOKENS=2048
APP_URL=

# --- Chat + Vision fallback (Gemini direct) ---
# Ignored while DISABLE_CLOUD_AI=true.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Chat fallback (text only) ---
# Ignored while DISABLE_CLOUD_AI=true.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional custom OpenAI-compatible provider (SERVER-SIDE ONLY) ---
# Ignored while DISABLE_CLOUD_AI=true.
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_DEFAULT_MODEL=
CUSTOM_OPENAI_ENABLE_VISION=false
CUSTOM_OPENAI_JSON_MODE=true

# --- Cloud provider order / toggle (SERVER-ONLY) ---
# Ignored while DISABLE_CLOUD_AI=true.
# Names: openrouter | custom_openai | gemini | groq.
CLOUD_PROVIDER_ORDER=

# --- Session signing (required in production) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Rate limit (optional) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin stats endpoint (optional) ---
ADMIN_TOKEN=

# --- Client-side feature flags ---
NEXT_PUBLIC_VISION_TIER=auto
NEXT_PUBLIC_CHAT_PROVIDER=local

# --- On-device WebLLM local planner (client-side) ---
# Default behavior when unset: enabled.
# Set either flag to false only when you want manual/no-local mode.
NEXT_PUBLIC_LOCAL_AI_ONLY=true
NEXT_PUBLIC_LOCAL_LLM_ENABLED=true
NEXT_PUBLIC_LOCAL_LLM_AUTO_FALLBACK=true
NEXT_PUBLIC_LOCAL_LLM_DEFAULT_MODEL=Llama-3.2-1B-Instruct-q4f32_1-MLC

# Build version surfaced in the UI footer.
NEXT_PUBLIC_APP_VERSION=1.7.1
